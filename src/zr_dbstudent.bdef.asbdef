managed implementation in class ZBP_R_DBSTUDENT unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_DBSTUDENT alias ZrDbstudent
persistent table ZDB_STUDENT
extensible
draft table ZDBSTUDENT_D
etag master Lastchanged
lock master total etag Lastchanged
authorization master( global )
{
  field ( mandatory : create )
   Rollnointernal,
   Rollno;

  field ( readonly )
   Lastchanged,
   Createdby,
   Changedby;

  field ( readonly : update )
   Rollnointernal,
   Rollno;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZDB_STUDENT corresponding extensible
  {
    Rollnointernal = ROLLNOINTERNAL;
    Rollno = ROLLNO;
    Dept = DEPT;
    Firstname = FIRSTNAME;
    Lastname = LASTNAME;
    Birthdate = BIRTHDATE;
    Emailid = EMAILID;
    Age = AGE;
    Lastchanged = LASTCHANGED;
    Createdby = CREATEDBY;
    Changedby = CHANGEDBY;
  }

}